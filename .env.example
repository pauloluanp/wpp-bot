DB_HOST=localhost
DB_NAME=wppbot
DB_USER=wppbot
DB_PASSWORD=wppbot
DB_PORT=5433
DB_SSL=false
TELEGRAM_BOT_TOKEN=seu_token_do_bot
TELEGRAM_POLLING=true
JWT_SECRET=sua_chave_secreta_para_jwt
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Shopee — credenciais GLOBAIS da Open API de afiliados (por enquanto; a migração
# para credenciais por margem, como no Mercado Livre, está pendente). Sem estas
# duas chaves, a conversão de links da Shopee fica desligada.
SHOPEE_APP_ID=seu_app_id_da_open_api
SHOPEE_SECRET=seu_app_secret_da_open_api
# Opcionais (têm default): SHOPEE_REQUEST_TIMEOUT, SHOPEE_CACHE_TTL_MS,
# SHOPEE_USER_AGENT, SHOPEE_SHORTLINK_HOSTS, SHOPEE_GRAPHQL_ENDPOINT
